{
  "name": "dayboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write src docs specs README.md",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "vitest run",
    "bench:core": "cargo run -p dayboard-core --example bench",
    "schemas": "cargo run -p dayboard-core --example schemas"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "svelte": "^5.39.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.12.0",
    "globals": "^16.4.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
