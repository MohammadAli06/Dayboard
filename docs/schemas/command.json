{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "ping_db"
        }
      },
      "required": [
        "command"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "snapshot"
        },
        "input": {
          "type": "object",
          "properties": {
            "search": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "parse_quick_add"
        },
        "input": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "create_task"
        },
        "input": {
          "type": "object",
          "properties": {
            "parent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "update_task"
        },
        "input": {
          "$ref": "#/$defs/TaskEdit"
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "complete_task"
        },
        "input": {
          "type": "object",
          "properties": {
            "completed": {
              "type": "boolean"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "completed"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "delete_task"
        },
        "input": {
          "type": "object",
          "properties": {
            "dry_run": {
              "type": "boolean"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "dry_run"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "restore_task"
        },
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "reschedule_task"
        },
        "input": {
          "type": "object",
          "properties": {
            "day": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "dry_run": {
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "local_start": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "dry_run"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "rollover"
        },
        "input": {
          "type": "object",
          "properties": {
            "dry_run": {
              "type": "boolean"
            }
          },
          "required": [
            "dry_run"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "save_settings"
        },
        "input": {
          "$ref": "#/$defs/Settings"
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "plan_day"
        },
        "input": {
          "type": "object",
          "properties": {
            "day": {
              "type": "string",
              "format": "date"
            },
            "energy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Energy"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "day"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "create_project"
        },
        "input": {
          "type": "object",
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/ProjectKind"
            },
            "name": {
              "type": "string"
            },
            "repo_path": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "kind"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "update_project"
        },
        "input": {
          "type": "object",
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/ProjectKind"
            },
            "name": {
              "type": "string"
            },
            "repo_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/ProjectStatus"
            }
          },
          "required": [
            "id",
            "name",
            "kind",
            "status"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "delete_project"
        },
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "create_goal"
        },
        "input": {
          "type": "object",
          "properties": {
            "horizon": {
              "$ref": "#/$defs/GoalHorizon"
            },
            "note": {
              "type": "string"
            },
            "target_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "horizon",
            "note"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "update_goal"
        },
        "input": {
          "type": "object",
          "properties": {
            "horizon": {
              "$ref": "#/$defs/GoalHorizon"
            },
            "id": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "target_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "horizon",
            "note"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "delete_goal"
        },
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "create_template"
        },
        "input": {
          "type": "object",
          "properties": {
            "energy": {
              "$ref": "#/$defs/Energy"
            },
            "est_min": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "name": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "priority": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "title",
            "notes",
            "priority",
            "energy",
            "est_min",
            "tags"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "create_task_from_template"
        },
        "input": {
          "type": "object",
          "properties": {
            "parent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "template_id": {
              "type": "string"
            }
          },
          "required": [
            "template_id"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "delete_template"
        },
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "import_issue"
        },
        "input": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "save_filter"
        },
        "input": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "view": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "view",
            "query"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "delete_filter"
        },
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "required": [
        "command",
        "input"
      ]
    }
  ],
  "$defs": {
    "Energy": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ]
    },
    "GoalHorizon": {
      "type": "string",
      "enum": [
        "medium",
        "long"
      ]
    },
    "ProjectKind": {
      "type": "string",
      "enum": [
        "coding",
        "college",
        "personal"
      ]
    },
    "ProjectStatus": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ]
    },
    "Settings": {
      "type": "object",
      "properties": {
        "max_minutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "timezone": {
          "type": "string"
        },
        "work_end": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "work_start": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "timezone",
        "max_tasks",
        "max_minutes",
        "work_start",
        "work_end"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "inbox",
        "todo",
        "doing",
        "done",
        "dropped"
      ]
    },
    "TaskEdit": {
      "type": "object",
      "properties": {
        "actual_min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "due_local": {
          "type": [
            "string",
            "null"
          ]
        },
        "energy": {
          "$ref": "#/$defs/Energy"
        },
        "est_min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "goal_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "planned_day": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "priority": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "scheduled_local": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "notes",
        "status",
        "priority",
        "energy",
        "est_min",
        "actual_min",
        "tags"
      ]
    }
  }
}